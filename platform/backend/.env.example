BACKEND_AUTH_ENABLED=false
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
DEFAULT_NEW_USER_ROLE=member
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# FastAPI config
VITE_API_BASE_URL=http://localhost:8000
DEBUG=True

GOOGLE_APPLICATION_CREDENTIALS=<PATH_TO_YOUR_SERVICE_JSON>service_account.json
DATABASE_URL=sqlite:///./comic_video.db
STORAGE_ROOT=./storage

# Local auth
AUTH_MODE=enabled
AUTH_JWT_SECRET=<CHANGE_ME>
AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRES_DAYS=14
AUTH_SESSION_COOKIE_NAME=platform_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_DOMAIN=
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Object storage
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://127.0.0.1:29000
MINIO_ACCESS_KEY=comic2video_minio
MINIO_SECRET_KEY=comic2video_minio_secret
MINIO_BUCKET=comic2video
MINIO_REGION=us-east-1
MINIO_SECURE=false

FFMPEG_BINARY=
FFPROBE_BINARY=
