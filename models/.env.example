# Shared
MODEL_DATA_ROOT=/data/models
MODEL_LOG_ROOT=/data/model-logs
TZ=Asia/Shanghai

# OCR example
OCR_IMAGE=your-registry/ocr-service:latest
OCR_CONTAINER_NAME=comic2video-ocr
OCR_PORT=8118
OCR_HOST_BIND=0.0.0.0
OCR_WORKDIR=/workspace
OCR_MODEL_DIR=/models/ocr

# Script example
SCRIPT_IMAGE=your-registry/llm-service:latest
SCRIPT_CONTAINER_NAME=comic2video-script
SCRIPT_PORT=8001
SCRIPT_HOST_BIND=0.0.0.0
SCRIPT_MODEL_PATH=/models/your-script-model
SCRIPT_MODEL_NAME=your-model-name
SCRIPT_GPU_MEMORY_UTILIZATION=0.90
SCRIPT_MAX_MODEL_LEN=8192
SCRIPT_TENSOR_PARALLEL_SIZE=1
SCRIPT_EXTRA_ARGS=
